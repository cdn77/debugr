{
  "private": true,
  "scripts": {
    ":skip:oxlint": "oxlint --ignore-pattern='packages/**'",
    ":skip:oxlint:fix": "oxlint --fix --ignore-pattern='packages/**'",
    "oxfmt": "oxfmt --check '!packages/' .",
    "oxfmt:fix": "oxfmt --write '!packages/' .",
    "lint": "pnpm run '/^(oxlint|oxfmt)$/'",
    "format": "pnpm run --sequential '/^(oxlint|oxfmt):fix$/'"
  },
  "devDependencies": {
    "oxfmt": "catalog:",
    "oxlint": "catalog:"
  },
  "engines": {
    "node": ">=24"
  }
}
